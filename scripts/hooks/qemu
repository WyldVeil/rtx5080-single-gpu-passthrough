#!/usr/bin/env bash
# libvirt QEMU hook. Fires the single-GPU passthrough bind/release for any domain
# whose NAME ends in "-gpu" (e.g. win11-gpu, endeavouros-gpu). Name your passthrough
# domain accordingly, or edit the case pattern below.
GUEST="$1"; OP="$2"; SUBOP="$3"

case "$GUEST" in
  *-gpu) ;;
  *) exit 0 ;;
esac

if [ "$OP" = "prepare" ] && [ "$SUBOP" = "begin" ]; then
  # libvirt passes the domain XML on stdin. Keep it, so the bind knows which files
  # this VM is about to open (CLEAR_USER_TMP must not delete them).
  if [ -t 0 ]; then : > /run/gpu-domain.xml; else ( umask 077; timeout 10 cat > /run/gpu-domain.xml ); fi
  # A bind that aborted has already restored the desktop: fail the start, so libvirt
  # stops here and the USB controller is never handed over.
  /usr/local/bin/vfio-gpu-bind.sh "$GUEST" || { echo "GPU bind aborted, see /var/log/vfio-gpu.log" >&2; exit 1; }
  /usr/local/bin/vfio-usb-bind.sh
elif [ "$OP" = "release" ] && [ "$SUBOP" = "end" ]; then
  /usr/local/bin/vfio-usb-release.sh
  /usr/local/bin/vfio-gpu-release.sh
fi
