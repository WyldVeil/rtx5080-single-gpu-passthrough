# /etc/vfio-passthrough.conf
# Settings for the single-GPU passthrough scripts. Edit these for YOUR system.
# Find PCI addresses with:  lspci -Dnn | grep -Ei 'vga|3d|audio|usb'
# (the leading 0000: is the PCI domain and is almost always 0000)

# The GPU (VGA/3D) function and its HDMI/DP audio function. Same card: .0 and .1.
GPU_PCI="0000:01:00.0"
GPU_AUDIO_PCI="0000:01:00.1"

# Your login/display manager systemd unit.
DISPLAY_MANAGER="sddm"

# Extra systemd units that ALSO hold the GPU from OUTSIDE the desktop session and
# must be stopped before nvidia can unload (space separated). Stopping the display
# manager alone will not release these. Common culprits:
#   plexmediaserver          (NVENC/NVDEC on /dev/nvidia-uvm)
#   lactd                    (LACT GPU control daemon: holds the card through NVML
#                             and restarts itself if killed, so it must be stopped)
#   ollama / any CUDA daemon
# chrome-remote-desktop@USER is auto-detected, no need to list it.
# Leave empty if none.
EXTRA_GPU_HOLDERS=""

# Seconds each GPU-holding service (the ones above, nvidia-persistenced and Chrome
# Remote Desktop) gets to stop before it is SIGKILLed. Plex, for one, can otherwise
# sit in "deactivating" for its full 90 s default while the launch waits.
HOLDER_STOP_TIMEOUT=8

# OPTIONAL: before the handover, delete everything of the desktop user's at the top
# of /tmp that nothing still needs, the way a reboot would. Only does anything when
# /tmp is a tmpfs (Arch, Fedora and others), where those files live in RAM. VFIO pins
# ALL of the guest's RAM, so with the VM sized close to the host's RAM, a few GB of
# old temp files can get QEMU OOM-killed seconds after it starts.
# Kept: hidden entries, mount points, folders holding sockets or fifos (tmux,
# ssh-agent), other users' and services' files, anything a running process has open,
# mapped or is working in (containers too), anything a mount or loop device uses, and
# anything the VM's own XML points at. Every deletion is logged in vfio-gpu.log.
# Off by default because it deletes files. 1 = on.
CLEAR_USER_TMP=0

# OPTIONAL: hand an entire USB controller to the guest (only if your host has a
# controller you are happy to lose while the VM runs; recovery is then SSH/ACPI,
# not USB). Leave BOTH empty to skip USB-controller passthrough entirely.
# USB_CTRL_PCI      = the xHCI controller
# USB_CTRL_MATE_PCI = its IOMMU group-mate, if the group has one (else leave empty)
USB_CTRL_PCI=""
USB_CTRL_MATE_PCI=""
